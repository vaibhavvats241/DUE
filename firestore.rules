rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() ? request.auth.uid == userId : true;
    }

    // 2. Groups Collection
    match /groups/{groupId} {
      allow read: if true;
      allow create: if request.resource.data.name is string && request.resource.data.name.size() > 0;
      allow update: if true;
      allow delete: if true;

      // Group Expenses Subcollection (Limit: Max 10,000,000 paise = ₹1,00,000)
      match /expenses/{expenseId} {
        allow read: if true;
        allow create: if request.resource.data.totalAmountPaise is number &&
                         request.resource.data.totalAmountPaise > 0 &&
                         request.resource.data.totalAmountPaise <= 10000000;
        allow update: if true;
        allow delete: if true;
      }

      // Group Payments Subcollection (Limit: Max 10,000,000 paise = ₹1,00,000)
      match /payments/{paymentId} {
        allow read: if true;
        allow create: if request.resource.data.amountPaise is number &&
                         request.resource.data.amountPaise > 0 &&
                         request.resource.data.amountPaise <= 10000000;
        allow update: if true;
        allow delete: if true;
      }
    }
  }
}

